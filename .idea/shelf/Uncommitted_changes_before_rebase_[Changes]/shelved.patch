+package com.example.hackathonprep;
+
+import android.content.Context;
+import com.example.hackathonprep.RetrofitClient;
+import com.example.hackathonprep.GeminiApiService;
+import java.io.File;
+import java.util.concurrent.CompletableFuture;
+
+public class EmergencyAudioProcessor {
+    private final AudioTranscriber audioTranscriber;
+
+    public EmergencyAudioProcessor(Context context) {
+        GeminiApiService apiService = RetrofitClient.getApiService();
+        this.audioTranscriber = new AudioTranscriber(context, apiService);
+    }
+
+    public void processEmergencyAudio(File audioFile, ProcessingCallback callback) {
+        new Thread(() -> {
+            try {
+                String prompt = "Analyze this audio for emergency situations. " +
+                        "Describe what's happening and identify if it's a critical emergency.";
+                String result = audioTranscriber.transcribeAudioFile(audioFile, prompt);
+                callback.onProcessingComplete(result);
+            } catch (Exception e) {
+                callback.onProcessingComplete("Error: " + e.getMessage());
+            }
+        }).start();
+    }
+
+    public interface ProcessingCallback {
+        void onProcessingComplete(String result);
+    }
+}
