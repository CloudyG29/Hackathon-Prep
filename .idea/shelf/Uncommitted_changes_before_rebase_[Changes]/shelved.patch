+package com.example.hackathonprep;
+
+
+import android.content.Context;
+import com.example.hackathonprep.GeminiApiService;
+import com.example.hackathonprep.RetrofitClient;
+import java.io.File;
+import java.util.Arrays;
+import java.util.List;
+
+public class AdvancedEmergencyDetector {
+    private static final List<String> CRITICAL_SOUNDS = Arrays.asList(
+            "scream", "gunshot", "crash", "explosion", "breaking glass"
+    );
+
+    private final EmergencyAnalyzer emergencyAnalyzer;
+
+    // CORRECTED CONSTRUCTOR: Add Context parameter only
+    public AdvancedEmergencyDetector(Context context) {
+        // Get API service from RetrofitClient
+        GeminiApiService apiService = RetrofitClient.getApiService();
+        this.emergencyAnalyzer = new EmergencyAnalyzer(context, apiService);
+    }
+
+    public boolean hasCriticalSoundPatterns(File audioFile) {
+        try {
+            String analysis = emergencyAnalyzer.analyzeEmergency(audioFile, "sound_pattern");
+            String lowerAnalysis = analysis.toLowerCase();
+
+            // Compatible with all Android versions
+            for (String sound : CRITICAL_SOUNDS) {
+                if (lowerAnalysis.contains(sound)) {
+                    return true;
+                }
+            }
+            return false;
+
+        } catch (Exception e) {
+            return false;
+        }
+    }
+}
